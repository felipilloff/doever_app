  "fixed_sql": [
    {
      "name": "lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL DEFAULT 4282542937, \"icon\" TEXT NOT NULL DEFAULT 'list', \"sort_order\" REAL NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"list_id\" TEXT NOT NULL REFERENCES lists (id), \"title\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"is_important\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_important\" IN (0, 1)), \"my_day_date\" TEXT NULL, \"due_date\" TEXT NULL, \"reminder_at\" INTEGER NULL, \"recurrence_rule\" TEXT NULL, \"sort_order\" REAL NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"deleted_at\" INTEGER NULL, \"next_occurrence_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"steps\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id), \"title\" TEXT NOT NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"sort_order\" REAL NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reminder_jobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder_jobs\" (\"notification_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" TEXT NOT NULL UNIQUE REFERENCES tasks (id), \"revision\" INTEGER NOT NULL DEFAULT 0, \"pending\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "tasks_list",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX tasks_list ON tasks (list_id, deleted_at, sort_order)"
        }
      ]
    },
